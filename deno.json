{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "dev:desktop": "deno desktop --hmr .",
    "build": "deno run -A npm:vite build",
    "preview": "deno run -A npm:vite preview",
    "test": "deno run -A npm:vitest run",
    "test:watch": "deno run -A npm:vitest",
    "check": "deno check",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno task fmt --check && deno task lint && deno task check && deno task test && deno task build"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": false,
    "exclude": ["node_modules/", "dist/", "deno.lock", "coverage/"]
  },
  "lint": {
    "exclude": ["node_modules/", "dist/", "coverage/"],
    "rules": {
      "exclude": ["no-sloppy-imports", "no-window", "no-window-prefix"]
    }
  }
}
