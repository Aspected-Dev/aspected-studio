{
  "name": "aspected-studio",
  "version": "0.1.0",

  "exports": "./src/main.tsx",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "dev:docs": "./utility/docs-dev.sh",
    "dev:all": "VITE_DOCS_LOCAL=true deno run -A npm:concurrently --kill-others \"deno task dev\" \"deno task dev:docs\"",
    "dev:desktop": "deno desktop --hmr .",
    "seed:catalog": "deno run -A utility/seed-catalog.ts",
    "seed:movies": "deno run -A utility/seed-movies.ts",
    "check:movies": "deno run -A utility/check-movies.ts",
    "verify:tutorials": "deno run -A utility/verify-tutorials.ts",
    "build": "deno run -A npm:vite build",
    "build:desktop": "./utility/build-desktop.sh",
    "preview": "deno run -A npm:vite preview",
    "test": "deno run -A npm:vitest run --testTimeout=15000 --maxWorkers=50%",
    "test:watch": "deno run -A npm:vitest --testTimeout=15000",
    "check": "deno check src/main.tsx utility/*.ts",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "ci": "deno task fmt --check && deno task lint && deno task check && deno task test && deno task build"
  },
  "desktop": {
    "app": {
      "name": "Aspected Studio",
      "identifier": "io.xillio.aspected.studio",
      "icons": {
        "macos": "./desktop/icons/aspected-studio-512.png",
        "windows": "./desktop/icons/aspected-studio.ico",
        "linux": "./desktop/icons/aspected-studio-512.png"
      }
    },
    "backend": "webview"
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": false,
    "exclude": ["node_modules/", "dist/", "release/", "deno.lock", "coverage/"]
  },
  "lint": {
    "exclude": ["node_modules/", "dist/", "release/", "coverage/"],
    "rules": {
      "exclude": ["no-sloppy-imports", "no-window", "no-window-prefix"]
    }
  }
}
