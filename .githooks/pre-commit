#!/usr/bin/env bash
set -euo pipefail

# Format staged content into the index without stash/add.
# No unstaged edits on a file -> also refresh the worktree so the commit stays clean.
# Unstaged edits on a file -> update index only (leave worktree alone).
#
# IMPORTANT: always pass --config. Staged blobs are formatted via mktemp paths
# under /tmp. Without an explicit config, deno fmt uses defaults (semicolons ON),
# which fights deno.json ("semiColons": false) and reintroduces fmt churn on
# every commit.

ROOT="$(git rev-parse --show-toplevel)"
CONFIG="$ROOT/deno.json"

mapfile -t staged < <(git diff --cached --name-only --diff-filter=ACM)

staged_existing=()
for file in "${staged[@]+"${staged[@]}"}"; do
  if [[ -n "$file" && -f "$file" ]]; then
    staged_existing+=("$file")
  fi
done

for file in "${staged_existing[@]+"${staged_existing[@]}"}"; do
  [[ -n "$file" ]] || continue

  had_unstaged=0
  if ! git diff --quiet -- "$file"; then
    had_unstaged=1
  fi

  # Use basename so paths like .githooks/pre-commit do not become a suffix
  # containing "/' (mktemp rejects that).
  base="${file##*/}"
  if [[ "$base" == *.* ]]; then
    ext="${base##*.}"
  else
    ext="txt"
  fi
  tmp="$(mktemp --suffix=".${ext}")"

  if ! git show ":${file}" > "$tmp"; then
    rm -f "$tmp"
    continue
  fi

  if ! deno fmt --config="$CONFIG" "$tmp" >/dev/null; then
    rm -f "$tmp"
    continue
  fi

  mode="$(git ls-files --stage -- "$file" | awk '{print $1}')"
  hash="$(git hash-object -w -- "$tmp")"
  git update-index --cacheinfo "${mode},${hash},${file}"

  if [[ "$had_unstaged" -eq 0 ]]; then
    cp -- "$tmp" "$file"
  fi

  rm -f "$tmp"
done

deno task lint
