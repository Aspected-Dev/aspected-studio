{
  "version": 1,
  "name": "Catalog baseline",
  "indexName": "catalog",
  "k": 5,
  "thresholds": {
    "metric": "ndcg",
    "green": 0.8,
    "amber": 0.5
  },
  "cases": [
    {
      "name": "Gaming laptop around 900",
      "notes": "At equal weights the 1499 model outranks the 899 one, so this sits just under green. Leaning on price fixes the order without a new search.",
      "tags": ["laptop", "price"],
      "aspects": [
        {
          "name": "title",
          "type": "text",
          "enabled": true,
          "value": "gaming laptop"
        },
        {
          "name": "category",
          "type": "enum",
          "enabled": true,
          "value": "laptop"
        },
        { "name": "brand", "type": "enum", "enabled": false, "value": "" },
        { "name": "price", "type": "number", "enabled": true, "value": "900" },
        { "name": "rating", "type": "number", "enabled": false, "value": "" },
        {
          "name": "released",
          "type": "datetime",
          "enabled": false,
          "value": ""
        }
      ],
      "expected": [
        { "id": "laptop-quanta-play-15", "gain": 3 },
        { "id": "laptop-nimbus-play-15", "gain": 1 }
      ],
      "forbidden": []
    },
    {
      "name": "Student laptop under 600",
      "notes": "A printer lands in the top five because enum aspects steer rather than filter. It is on the forbidden list, so this case is red however good the numbers look. Raise the category weight to clear it.",
      "tags": ["laptop", "policy"],
      "aspects": [
        {
          "name": "title",
          "type": "text",
          "enabled": true,
          "value": "laptop for a student, email and homework"
        },
        {
          "name": "category",
          "type": "enum",
          "enabled": true,
          "value": "laptop"
        },
        { "name": "brand", "type": "enum", "enabled": false, "value": "" },
        { "name": "price", "type": "number", "enabled": true, "value": "600" },
        { "name": "rating", "type": "number", "enabled": false, "value": "" },
        {
          "name": "released",
          "type": "datetime",
          "enabled": false,
          "value": ""
        }
      ],
      "expected": [
        { "id": "laptop-vertex-book-14", "gain": 3 },
        { "id": "laptop-quanta-value-15", "gain": 2 }
      ],
      "forbidden": ["printer-nimbus-inkjet"]
    },
    {
      "name": "Noise cancelling headphones for flights",
      "notes": "The easy case. If this one is not green, something is wrong with the index rather than the weights.",
      "tags": ["headphones"],
      "aspects": [
